#!/bin/sh
set -eu
profile=$(mktemp -d)
pid=
cleanup() {
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
    rm -rf -- "$profile"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
if [ "${AMOEBA_CAGE:-0}" = 1 ]; then
    cage -- "${AMOEBA_BROWSER:-chromium}" --ozone-platform=wayland --no-first-run --disable-background-mode          --user-data-dir="$profile" --app="$1" &
else
    "${AMOEBA_BROWSER:-chromium}" --no-first-run --disable-background-mode         --user-data-dir="$profile" --app="$1" &
fi
pid=$!
wait "$pid"
