(in-package #:score-prototype)

(load (merge-pathnames "score-stream.lisp" *source-directory*))

(defstruct mixer root snapshot draft items history gesture (mode "b") (cursor 0)
  frames raw-a raw-b peaks-a peaks-b cached-items playback error xruns
  punch-from punch-to (takes nil) takes-ready recording (take-base nil) take-preview (view-epoch 0))

(defun mixer-project (mixer)
  (let ((project (mixer-snapshot mixer)))
    (if (equal "a" (mixer-mode mixer)) project
        (let ((copy (copy-tree project)))
          (setf (getf copy :mix-trim) (mixer-draft mixer)
                (getf copy :items) (mixer-items mixer))
          copy))))

(defun mixer-rate (mixer) (getf (mixer-snapshot mixer) :sample-rate))
(defun mixer-step (mixer) (max 1 (round (mixer-rate mixer) 20)))

(defun mix-peaks (pcm step)
  (declare (type sample-vector pcm) (type fixnum step) (optimize (speed 3)))
  (loop for base of-type fixnum from 0 below (length pcm) by (* 2 step)
        collect (loop with left of-type fixnum = 0 and right of-type fixnum = 0
                      for i of-type fixnum from base below (min (length pcm) (+ base (* 2 step))) by 2
                      do (setf left (max left (abs (aref pcm i)))
                               right (max right (abs (aref pcm (1+ i)))))
                      finally (return (list left right)))))

(defun mixer-render-bank (mixer project)
  (let* ((raw (copy-list project))
         (data (audition-data (mixer-root mixer)))
         (parts (getf raw :parts))
         (blocks (make-array (length parts)))
         (peaks (make-array (length parts))))
    (remf raw :mix-trim)
    (loop for part in parts for index from 0
          for pcm = (render-part (mixer-root mixer) raw data part 0 (mixer-frames mixer))
          do (setf (aref blocks index) pcm
                   (aref peaks index) (mix-peaks pcm (mixer-step mixer))))
    (values blocks peaks)))

(defun track-points (items data part)
  (remove-if-not (lambda (item) (and (eq (getf item :kind) :automation)
                                     (equal part (getf item :part))
                                     (automation-gain item data)))
                 items))

(defun mixer-refresh-b (mixer)
  (let* ((snapshot (mixer-snapshot mixer))
         (parts (getf snapshot :parts))
         (original (getf snapshot :items))
         (items (mixer-items mixer))
         (previous (mixer-cached-items mixer))
         (project (copy-list snapshot))
         (data (audition-data (mixer-root mixer)))
         (raw (copy-seq (or (mixer-raw-b mixer) (mixer-raw-a mixer))))
         (peaks (copy-seq (or (mixer-peaks-b mixer) (mixer-peaks-a mixer)))))
    (remf project :mix-trim)
    (setf (getf project :items) items)
    (loop for part in parts for index from 0
          for current = (remove part items :key (lambda (item) (getf item :part)) :test-not #'equal)
          do (cond ((equal current (remove part original :key (lambda (item) (getf item :part)) :test-not #'equal))
                    (setf (aref raw index) (aref (mixer-raw-a mixer) index)
                          (aref peaks index) (aref (mixer-peaks-a mixer) index)))
                   ((not (equal current (remove part previous :key (lambda (item) (getf item :part)) :test-not #'equal)))
                    (let ((pcm (render-part (mixer-root mixer) project data part 0 (mixer-frames mixer))))
                      (setf (aref raw index) pcm
                            (aref peaks index) (mix-peaks pcm (mixer-step mixer)))))))
    (setf (mixer-raw-b mixer) raw (mixer-peaks-b mixer) peaks
          (mixer-cached-items mixer) items)))

(defun mixer-bank (mixer)
  (let* ((project (mixer-project mixer))
         (raw (if (equal "a" (mixer-mode mixer)) (mixer-raw-a mixer) (mixer-raw-b mixer))))
    (map 'vector (lambda (pcm part) (cons pcm (if (and (mixer-recording mixer) (equal part "Voice")) 0d0 (trim-factor project part)))) raw (getf project :parts))))

(defun mixer-publish (mixer)
  (when (mixer-playback mixer)
    (setf (mix-stream-bank (mixer-playback mixer)) (mixer-bank mixer))))

(defun mixer-stop (mixer)
  (let ((stream (mixer-playback mixer)))
    (when stream
      (setf (mix-stream-stop stream) t)
      (sb-thread:join-thread (mix-stream-thread stream))
      (setf (mixer-cursor mixer) (mix-stream-cursor stream)
            (mixer-error mixer) (mix-stream-error stream)
            (mixer-xruns mixer) (mix-stream-xruns stream)
            (mixer-playback mixer) nil))))

(defun mixer-start (mixer)
  (when (>= (mixer-cursor mixer) (mixer-frames mixer)) (setf (mixer-cursor mixer) 0))
  (let* ((device (audio-device (mixer-root mixer)))
         (bank (mixer-bank mixer))
         (stream (make-mix-stream :bank bank :cursor (mixer-cursor mixer)
                                   :levels (make-array (* 2 (length bank)) :element-type '(signed-byte 32)
                                                                     :initial-element 0))))
    (setf (mixer-playback mixer) stream (mixer-error mixer) nil (mixer-xruns mixer) 0
          (mix-stream-thread stream)
          (sb-thread:make-thread (lambda () (run-mix-stream stream device (mixer-rate mixer)
                                                           (mixer-frames mixer)))
                                 :name "AMOEBA ALSA mix"))
    (loop repeat 40 until (or (mix-stream-ready stream) (mix-stream-error stream)) do (sleep .005))
    (when (mix-stream-error stream) (mixer-stop mixer) (error "~A" (mixer-error mixer)))))

(defun mixer-checkpoint (mixer) (cons (mixer-draft mixer) (mixer-items mixer)))

(defun mixer-gain-set (mixer index tenths)
  (unless (<= -240 tenths 60) (error "Gain range is −24 to +6 dB."))
  (let* ((part (nth index (getf (mixer-snapshot mixer) :parts)))
         (old (mixer-draft mixer))
         (current (or (cdr (assoc part old :test #'equal)) 0)))
    (unless part (error "Unknown track."))
    (unless (= current tenths)
      (unless (eql index (mixer-gesture mixer))
        (push (mixer-checkpoint mixer) (mixer-history mixer))
        (setf (mixer-gesture mixer) index))
      (let ((others (remove part old :key #'car :test #'equal)))
        (setf (mixer-draft mixer) (if (zerop tenths) others (acons part tenths others))
              (mixer-mode mixer) "b"))
      (mixer-publish mixer))))

(defun mixer-reload (mixer)
  (setf (mixer-snapshot mixer) (project-state (mixer-root mixer))
        (mixer-draft mixer) (copy-tree (getf (mixer-snapshot mixer) :mix-trim))
        (mixer-items mixer) (getf (mixer-snapshot mixer) :items)
        (mixer-history mixer) nil (mixer-mode mixer) "b"
        (mixer-frames mixer) (beats-to-frame (mixer-snapshot mixer)
                                             (project-render-end (mixer-snapshot mixer))))
  (unless (<= 1 (mixer-frames mixer) (* 90 (mixer-rate mixer)))
    (error "Mixer view supports projects up to 90 seconds."))
  (multiple-value-bind (pcm peaks) (mixer-render-bank mixer (mixer-snapshot mixer))
    (setf (mixer-raw-a mixer) pcm (mixer-peaks-a mixer) peaks))
  (mixer-refresh-b mixer)
  (mixer-publish mixer))

(defun mixer-dirty-p (mixer)
  (or (not (equal (mixer-draft mixer) (getf (mixer-snapshot mixer) :mix-trim)))
      (not (equal (mixer-items mixer) (getf (mixer-snapshot mixer) :items)))))

(defun mixer-save (mixer)
  (when (mixer-dirty-p mixer)
    (let* ((root (mixer-root mixer))
           (base (getf (mixer-snapshot mixer) :revision))
           (project (mixer-project mixer))
           (pcm (render-mix root project 0 (project-render-end project))))
      (unless (every (lambda (sample) (<= -8388608 sample 8388607)) pcm)
        (error "Mix clips. Lower the gain before saving."))
      (call-with-project-lock root
        (lambda ()
          (assert-revision (project-state root) base)
          (commit-project root project base)))
      (mixer-reload mixer))))

(defun automation-db (item data)
  (or (getf item :gain-db)
      (round (* 200d0 (log (automation-gain item data) 10d0)))))

(defun mixer-point (mixer track index frame db)
  (unless (and (<= 0 frame (1- (mixer-frames mixer))) (<= -240 db 60))
    (error "Automation requires a position in the project and −24 to +6 dB."))
  (let* ((snapshot (mixer-snapshot mixer))
         (part (or (nth track (getf snapshot :parts)) (error "Unknown track.")))
         (data (audition-data (mixer-root mixer)))
         (checkpoint (mixer-checkpoint mixer))
         (items (copy-tree (mixer-items mixer)))
         (points (track-points items data part))
         (previous (unless (equal index "new")
                     (or (nth (parse-integer index) points) (error "Unknown automation point."))))
         (point (or previous
                    (list :id (concatenate 'string "gain-" (score-nonce))
                          :kind :automation :part part :unit :beat :duration 0))))

    (when (some (lambda (other) (and (not (eq point other)) (= frame (item-frame snapshot other)))) points)
      (error "This track already has an automation point at that frame."))
    (unless (and (getf point :start) (= db (automation-db point data)))
      (setf (getf point :gain-db) db))
    (setf (getf point :start) (if (eq :frame (getf point :unit)) frame
                                  (/ (* frame (getf snapshot :bpm)) (* 60 (mixer-rate mixer)))))
    (setf items (if previous (substitute point previous items :test #'eq)
                    (append items (list point))))
    (let ((mode (mixer-mode mixer)))
      (setf (mixer-items mixer) items (mixer-mode mixer) "b")
      (handler-case (mixer-refresh-b mixer)
        (error (condition) (setf (mixer-items mixer) (cdr checkpoint) (mixer-mode mixer) mode)
                           (error condition))))
    (push checkpoint (mixer-history mixer))
    (mixer-publish mixer)))

(defun mixer-action (mixer path)
  (when (member (first path) '("close" "detach") :test #'equal)
    (when (mixer-recording mixer) (funcall (symbol-function 'take-cancel) mixer))
    (incf (mixer-view-epoch mixer))
    (return-from mixer-action nil))
  (when (equal (first path) "start")
    (unless (mixer-playback mixer) (mixer-start mixer))
    (return-from mixer-action nil))
  (when (and (equal (first path) "stop") (mixer-recording mixer))
    (funcall (symbol-function 'take-cancel) mixer)
    (return-from mixer-action nil))
  (when (equal (first path) "jump")
    (when (mixer-recording mixer) (error "Finish or cancel the active recording first."))
    (unless (= (length path) 2) (error "Choose a section."))
    (let* ((index (parse-integer (second path)))
           (sections (getf (mixer-snapshot mixer) :sections))
           (id (and (<= 0 index (1- (length sections))) (first (nth index sections)))))
      (unless id (error "Unknown section."))
      (select-section (mixer-root mixer) id (getf (mixer-snapshot mixer) :revision))
      (return-from mixer-action
        (mixer-action mixer (list "seek"
                                  (write-to-string (beats-to-frame (mixer-snapshot mixer)
                                                                  (section-start (mixer-snapshot mixer) id))))))))
  (when (eql 0 (search "take-" (first path)))
    (return-from mixer-action (funcall (symbol-function 'take-action) mixer path)))
  (when (mixer-recording mixer)
    (error "Finish or cancel the active take first."))
  (when (and (mixer-take-preview mixer)
             (member (first path) '("gain" "point" "undo" "restore") :test #'equal))
    (error "Finish or discard the take preview before other edits."))
  (let ((action (first path)) (args (rest path)))
    (unless (= (length args) (cond ((equal action "gain") 2) ((equal action "point") 4)
                                   ((equal action "seek") 1) (t 0)))
      (error "Invalid mixer command arguments."))
    (unless (equal action "gain") (setf (mixer-gesture mixer) nil))
    (cond
      ((equal action "play") (if (mixer-playback mixer) (mixer-stop mixer) (mixer-start mixer)))
      ((equal action "stop") (mixer-stop mixer))
      ((equal action "seek")
       (let ((frame (min (mixer-frames mixer) (max 0 (parse-integer (first args))))))
         (if (mixer-playback mixer) (setf (mix-stream-seek (mixer-playback mixer)) frame)
             (setf (mixer-cursor mixer) frame))))
      ((member action '("a" "b") :test #'equal)
       (setf (mixer-mode mixer) action) (mixer-publish mixer))
      ((equal action "gain") (apply #'mixer-gain-set mixer (mapcar #'parse-integer args)))
      ((equal action "gain-end") nil)
      ((equal action "point")
       (destructuring-bind (track index frame db) args
         (mixer-point mixer (parse-integer track) index (parse-integer frame) (parse-integer db))))
      ((equal action "undo")
       (when (mixer-history mixer)
         (let ((checkpoint (pop (mixer-history mixer))))
           (setf (mixer-draft mixer) (car checkpoint) (mixer-items mixer) (cdr checkpoint)
                 (mixer-mode mixer) "b")
           (mixer-refresh-b mixer)
           (mixer-publish mixer))))
      ((equal action "save")
       (unless (equal "b" (mixer-mode mixer)) (error "Switch to B before saving."))
       (when (mixer-take-preview mixer) (error "Apply the comp in the take editor first."))
       (mixer-save mixer))
      ((equal action "restore")
       (when (mixer-dirty-p mixer) (error "Undo the draft edits before restoring a revision."))
       (let* ((root (mixer-root mixer))
              (snapshot (mixer-snapshot mixer))
              (parent (getf snapshot :parent)))
         (when (and parent (mixer-playback mixer)
                    (let ((prior (read-data (revision-file root parent))))
                      (/= (mixer-frames mixer) (beats-to-frame prior (project-render-end prior)))))
           (mixer-stop mixer))
         (rollback root (getf snapshot :revision)))
       (mixer-reload mixer))
      (t (error "Unknown mixer action.")))))

(defun mixer-json-text (out value)
  (write-char #\" out)
  (loop for c across value do
    (case c
      (#\" (write-string "\\\"" out)) (#\\ (write-string "\\\\" out))
      (otherwise (if (< (char-code c) 32) (format out "\\u~4,'0X" (char-code c))
                     (write-char c out)))))
  (write-char #\" out))

(defun mixer-data-json (mixer)
  (let* ((project (mixer-project mixer))
         (data (audition-data (mixer-root mixer)))
         (peaks (if (equal "a" (mixer-mode mixer)) (mixer-peaks-a mixer) (mixer-peaks-b mixer))))
    (with-output-to-string (out)
      (format out "{\"rate\":~D,\"length\":~D,\"step\":~D,\"bpm\":~D,\"bar\":~D,\"title\":"
              (mixer-rate mixer) (mixer-frames mixer) (mixer-step mixer)
              (getf project :bpm) (getf project :beats-per-bar))
      (mixer-json-text out (getf project :title))
      (write-string ",\"tracks\":[" out)
      (loop for part in (getf project :parts) for index from 0
            do (unless (zerop index) (write-char #\, out))
               (write-string "{\"name\":" out) (mixer-json-text out part)
               (format out ",\"trim\":~D,\"viewTrim\":~D,\"peaks\":[~{~{[~D,~D]~}~^,~}],\"automation\":["
                       (or (cdr (assoc part (mixer-draft mixer) :test #'equal)) 0)
                       (or (cdr (assoc part (getf project :mix-trim) :test #'equal)) 0) (aref peaks index))
               (loop for item in (track-points (getf project :items) data part) for n from 0
                     do (unless (zerop n) (write-char #\, out))
                        (format out "[~D,~D,~D]" (item-frame project item)
                                (round (* 1000 (automation-gain item data))) (automation-db item data)))
               (write-string "]}" out))
      (write-string "],\"sections\":[" out)
      (loop for (id bars) in (getf project :sections) for n from 0
            do (unless (zerop n) (write-char #\, out))
               (mixer-json-text out id))
      (write-string "]}" out))))

(defun mixer-frame (mixer)
  (let ((stream (mixer-playback mixer)))
    (if stream (mix-stream-cursor stream) (mixer-cursor mixer))))

(defun mixer-position-bar (mixer frame)
  (let* ((project (mixer-snapshot mixer))
         (beat (/ (* frame (getf project :bpm)) (* 60 (mixer-rate mixer)))))
    (1+ (floor beat (getf project :beats-per-bar)))))

(defun mixer-section-at-bar (mixer bar)
  (loop with start = 0 for (id bars) in (getf (mixer-snapshot mixer) :sections)
        do (incf start bars)
        when (<= bar start) return id))

(defun mixer-state-json (mixer)
  (when (and (mixer-playback mixer) (not (sb-thread:thread-alive-p (mix-stream-thread (mixer-playback mixer)))))
    (mixer-stop mixer))
  (let ((stream (mixer-playback mixer)))
    (with-output-to-string (out)
      (format out "{\"cursor\":~D,\"playing\":~A,\"mode\":\"~A\",\"revision\":~D,\"draft\":~A,\"undo\":~A,\"history\":~A,\"xruns\":~D,\"blocks\":~D,\"levels\":[~{~D~^,~}],\"error\":"
              (if stream (mix-stream-cursor stream) (mixer-cursor mixer))
              (if stream "true" "false") (mixer-mode mixer)
              (getf (mixer-snapshot mixer) :revision) (if (mixer-dirty-p mixer) "true" "false")
              (if (getf (mixer-snapshot mixer) :parent) "true" "false")
              (if (mixer-history mixer) "true" "false")
              (if stream (mix-stream-xruns stream) (or (mixer-xruns mixer) 0))
              (if stream (mix-stream-blocks stream) 0)
              (when stream (coerce (mix-stream-levels stream) 'list)))
      (if (mixer-error mixer) (mixer-json-text out (mixer-error mixer)) (write-string "null" out))
      (write-string ",\"section\":" out)
      (let ((section (mixer-section-at-bar mixer (mixer-position-bar mixer (mixer-frame mixer)))))
        (if section (mixer-json-text out section) (write-string "null" out)))
      (write-char #\} out))))


(defun mixer-response (stream code type text)
  (let ((crlf (format nil "~C~C" #\Return #\Newline)))
    (format stream "HTTP/1.1 ~A~AContent-Type: ~A; charset=utf-8~AContent-Length: ~D~AConnection: close~ACache-Control: no-store~AX-Content-Type-Options: nosniff~AContent-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'~A~A"
            code crlf type crlf (length (sb-ext:string-to-octets text :external-format :utf-8))
            crlf crlf crlf crlf crlf crlf)
    (write-string text stream)
    (finish-output stream)))

(defun mixer-location (mixer)
  (mixer-state-json mixer)
  (let* ((stream (mixer-playback mixer))
         (cursor (mixer-frame mixer))
         (project (mixer-snapshot mixer))
         (bar (mixer-position-bar mixer cursor))
         (section (mixer-section-at-bar mixer bar)))
    (format nil "~A | ~A | ~,3Fs | bar ~D~@[ (~A)~] | frame ~D | REV ~D~%~@[Audio: ~A~%~]"
            (getf project :title) (if stream "PLAYING" "STOPPED") (/ cursor (float (mixer-rate mixer)))
            bar section cursor (getf project :revision) (mixer-error mixer))))

(defun mixer-request (client mixer host base)
  (sb-ext:with-timeout 8
    (with-open-stream (stream (sb-bsd-sockets:socket-make-stream client :input t :output t
                                    :element-type 'character :external-format :utf-8 :buffering :full))
      (let* ((request (score-http-line stream))
             (start (position #\Space request))
             (end (position #\Space request :from-end t))
             (method (and start (subseq request 0 start)))
             (path (and start (< start end) (subseq request (1+ start) end)))
             (origin (concatenate 'string "http://" host))
             (got-host nil) (got-origin nil))
        (loop repeat 40 for header = (score-http-line stream) until (equal header "")
              for colon = (position #\: header)
              when colon do (let ((name (subseq header 0 colon))
                                   (value (string-trim '(#\Space #\Tab) (subseq header (1+ colon)))))
                               (cond ((string-equal name "Host") (setf got-host (equal value host)))
                                     ((string-equal name "Origin") (setf got-origin (equal value origin))))))
        (flet ((response (type body) (mixer-response stream "200 OK" type body)))
          (let ((resource (and got-host path (eql 0 (search base path)) (subseq path (length base)))))
            (cond
              ((and resource (equal method "GET"))
               (let ((file (assoc resource '(("" "mixer.html" "text/html")
                                             ("mixer.js" "mixer.js" "text/javascript")
                                             ("mixer.css" "mixer.css" "text/css")) :test #'equal)))
                 (cond (file (response (third file)
                                       (with-output-to-string (out)
                                         (with-open-file (in (merge-pathnames (second file) *source-directory*)
                                                             :external-format :utf-8)
                                           (loop for line = (read-line in nil) while line do (write-line line out))))))
                       ((equal resource "state") (response "application/json" (mixer-state-json mixer)))
                       ((equal resource "view") (response "text/plain" (write-to-string (mixer-view-epoch mixer))))
                       ((equal resource "location") (response "text/plain" (mixer-location mixer)))
                       ((equal resource "data") (response "application/json" (mixer-data-json mixer)))
                       ((equal resource "takes") (response "application/json"
                                                    (funcall (symbol-function 'take-status-json) mixer)))
                       (t (mixer-response stream "404 Not Found" "text/plain" "Not found.")))))
              ((and got-origin resource (equal method "POST") (eql 0 (search "action/" resource)))
               (handler-case
                   (let* ((command (subseq resource 7))
                          (args (loop for start = 0 then (1+ slash)
                                      for slash = (position #\/ command :start start)
                                      collect (subseq command start slash)
                                      while slash))
                          (result (mixer-action mixer args)))
                     (response "application/json" (mixer-state-json mixer))
                     result)
                 (error (condition)
                   (mixer-response stream "409 Conflict" "text/plain" (princ-to-string condition)))))
              (t (mixer-response stream "404 Not Found" "text/plain" "Not found.")))))))))

(defun mixer-step-server (socket mixer host base)
  (when (sb-sys:wait-until-fd-usable (sb-bsd-sockets:socket-file-descriptor socket) :input .15)
    (let ((client (sb-bsd-sockets:socket-accept socket)))
      (unwind-protect
           (handler-case (mixer-request client mixer host base) (error () nil))
        (ignore-errors (sb-bsd-sockets:socket-close client))))))

(load (merge-pathnames "score-takes.lisp" *source-directory*))

(defun run-score-daemon (root)
  (let ((mixer (make-mixer :root root))
        (stop-requested nil) (shutdown nil))
    (mixer-reload mixer)
    (sb-sys:enable-interrupt sb-unix:sigusr1
      (lambda (&rest arguments)
        (declare (ignore arguments))
        (let ((stream (mixer-playback mixer)) (capture (mixer-recording mixer)))
          (when stream (setf (mix-stream-stop stream) t))
          (when capture (setf (capture-take-stop capture) t))
          (setf stop-requested t))))
    (sb-sys:enable-interrupt sb-unix:sigterm
      (lambda (&rest arguments) (declare (ignore arguments)) (setf shutdown t)))
    (call-with-score-server
     (lambda (socket host base)
       (unwind-protect
            (progn
              (write-data (session-file) (list :root (namestring root)
                                               :url (format nil "http://~A~A" host base)))
              (loop until shutdown
                    do (when stop-requested
                         (setf stop-requested nil)
                         (if (mixer-recording mixer) (take-cancel mixer) (mixer-stop mixer)))
                       (take-tick mixer)
                       (mixer-state-json mixer)
                       (mixer-step-server socket mixer host base)))
         (ignore-errors (delete-file (session-file)))
         (take-cancel mixer)
         (mixer-stop mixer))))))
