(in-package #:score-prototype)

(defparameter *session-unit* "amoeba-daw.service")

(defun session-runtime (file)
  (format nil "~A/~A" (or (sb-ext:posix-getenv "AMOEBA_RUNTIME_DIR")
                           (sb-ext:posix-getenv "XDG_RUNTIME_DIR")
                           (format nil "/run/user/~D" (sb-posix:getuid))) file))

(defun session-file () (session-runtime "amoeba-daw-session.sexp"))

(defun session-source (name) (namestring (merge-pathnames name *source-directory*)))

(defun session-call (program args &key quiet)
  (let* ((out (make-string-output-stream))
         (proc (sb-ext:run-program program args :search t :input nil :output out
                                   :error (if quiet nil out)))
         (text (get-output-stream-string out)))
    (values text (sb-ext:process-exit-code proc))))

(defun session-systemd (program &rest args)
  (session-call "env" (list* (format nil "XDG_RUNTIME_DIR=~A" (format nil "/run/user/~D" (sb-posix:getuid)))
                            (format nil "DBUS_SESSION_BUS_ADDRESS=unix:path=~A" (format nil "/run/user/~D/bus" (sb-posix:getuid)))
                            program "--user" args)))

(defun session-url (root &optional optional)
  (let ((entry (when (probe-file (session-file)) (read-data (session-file)))))
    (cond ((not entry) (unless optional (error "No DAW session. Start with :score play or :score mix.")))
          ((not (equal (getf entry :root) (namestring root)))
           (error "Another project owns the engine. Use :score stop or :score session end to release it."))
          ((not (and (stringp (getf entry :url)) (eql 0 (search "http://127.0.0.1:" (getf entry :url)))))
           (error "Invalid DAW session address."))
          (t (getf entry :url)))))

(defun session-request (url path &key post)
  (multiple-value-bind (body status)
      (session-call "curl"
                    (append '("--fail-with-body" "--silent" "--show-error" "--max-time" "4")
                            (when post
                              (list "-X" "POST" "-H"
                                    (concatenate 'string "Origin: " (subseq url 0 (position #\/ url :start 7)))))
                            (list (concatenate 'string url path))))
    (unless (eql status 0) (error "~A" (string-trim '(#\Newline #\Return) body)))
    body))

(defun session-ensure (root)
  (let ((current (session-url root t)))
    (when (and current (ignore-errors (session-request current "view")))
      (return-from session-ensure current)))
  (multiple-value-bind (message status)
      (apply #'session-systemd "systemd-run"
             (append '("--collect" "--quiet" "--unit=amoeba-daw")
                     (loop for key in '("AMOEBA_RUNTIME_DIR" "AMOEBA_PCM" "AMOEBA_CAPTURE_PCM" "AMOEBA_ALSA_LIBRARY")
                           for value = (sb-ext:posix-getenv key)
                           when value collect (format nil "--setenv=~A=~A" key value))
                     (list (namestring sb-ext:*runtime-pathname*) "--script"
                           (session-source "score-console.lisp") (namestring root) "serve")))
    (loop repeat 35
          do (sleep .1)
             (let ((candidate (session-url root t)))
               (when (and candidate (ignore-errors (session-request candidate "view")))
                 (return candidate)))
          finally (error "DAW session did not start (~A). ~A" status message))))

(defun serve-score-session (root)
  (load (session-source "score-view.lisp"))
  (load (session-source "score-mixer.lisp"))
  (funcall (symbol-function 'run-score-daemon) root))

(defun spawn-amoeba-viewer (url)
  (sb-ext:run-program (or (sb-ext:posix-getenv "AMOEBA_VIEWER")
                           (namestring (merge-pathnames "../bin/amoeba-view" *source-directory*)))
                      (list url) :input nil :output t :error t :search t :wait nil))

(defun open-session-view (url)
  (with-open-file (lock (session-runtime "amoeba-daw-view.lock") :direction :output
                        :if-exists :append :if-does-not-exist :create)
    (unless (zerop (file-lock (sb-sys:fd-stream-fd lock) 6))
      (error "A mixer view is already attached."))
    (let* ((epoch (session-request url "view"))
           (viewer (spawn-amoeba-viewer url)))
        (unwind-protect
             (loop while (sb-ext:process-alive-p viewer)
                   while (equal epoch (session-request url "view"))
                   do (sleep .23))
          (ignore-errors (session-request url "action/detach" :post t))
          (when (sb-ext:process-alive-p viewer) (sb-ext:process-kill viewer 15))
          (sb-ext:process-wait viewer))
        (unless (eql 0 (sb-ext:process-exit-code viewer))
          (format t "~&Mixer view closed. The DAW session is still available.~%")))))

(defun session-action (url action)
  (session-request url (concatenate 'string "action/" action) :post t))

(defun session-jump (root url section)
  (let ((index (position section (getf (project-state root) :sections) :key #'first :test #'string-equal)))
    (unless index (error "Unknown section: ~A" section))
    (session-action url (format nil "jump/~D" index))))

(defun session-command (root command value)
  (cond ((and (equal command "serve") (not value)) (serve-score-session root))
        ((and (equal command "mix") (not value)) (open-session-view (session-ensure root)))
        ((and (equal command "at") (not value))
         (write-string (session-request (session-url root) "location")))
        ((and (equal command "stop") (not value))
         (multiple-value-bind (message status)
             (session-systemd "systemctl" "kill" "--kill-whom=main" "--signal=USR1" *session-unit*)
           (unless (zerop status) (error "~A" message))
           (format t "Stop sent to audio engine.~%")))
        ((equal command "session")
         (cond ((not value) (write-string (session-request (session-ensure root) "location")))
               ((equal value "end")
                (multiple-value-bind (message status)
                    (session-systemd "systemctl" "stop" *session-unit*)
                  (unless (zerop status) (error "~A" message)))
                (format t "DAW session ended.~%"))
               (t (error "Use :score session or :score session end."))))
        ((equal command "play")
         (let ((url (session-ensure root)))
           (when value (session-jump root url value))
           (session-action url "start")
           (write-string (session-request url "location"))))
        ((and (equal command "jump") value)
         (let ((url (session-ensure root)))
           (session-jump root url value)
           (write-string (session-request url "location"))))
        ((and (equal command "seek") value)
         (let* ((url (session-ensure root))
                (rate (getf (project-state root) :sample-rate))
                (*read-eval* nil))
           (multiple-value-bind (seconds end) (read-from-string value nil nil)
             (unless (and (realp seconds) (<= 0 seconds 86400) (= end (length value)))
               (error "Use :score seek SECONDS."))
             (session-action url (format nil "seek/~D" (round (* rate seconds))))
             (write-string (session-request url "location")))))
        (t (error "Invalid DAW session command."))))
