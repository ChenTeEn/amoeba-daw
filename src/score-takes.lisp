(in-package #:score-prototype)

(stream-alsa "snd_pcm_readi" take-read sb-alien:long
 (handle sb-alien:system-area-pointer) (buffer sb-alien:system-area-pointer) (frames sb-alien:unsigned-long))
(stream-alsa "snd_pcm_start" take-start sb-alien:int (handle sb-alien:system-area-pointer))

(defstruct capture-take stream thread stop result error route (offset 0) (check 0))

(defun take-input-device ()
  (sb-ext:posix-getenv "AMOEBA_CAPTURE_PCM"))

(defun take-dir (root name)
  (project-file root (concatenate 'string "takes/" name)))

(defun take-key (row) (getf row :id))

(defun load-takes (mixer)
  (setf (mixer-takes mixer)
        (sort (mapcar #'read-data (directory (take-dir (mixer-root mixer) "*.sexp")))
              #'< :key (lambda (row) (getf row :at)))))

(defun persist-take (mixer pcm &optional route (offset 0))
  (let* ((id (score-nonce))
         (name (format nil "takes/~A.wav" id))
         (wave (project-file (mixer-root mixer) name))
         (manifest (take-dir (mixer-root mixer) (format nil "~A.sexp" id)))
         (row (list :id id :at (get-universal-time) :asset name
                    :from (mixer-punch-from mixer) :to (mixer-punch-to mixer)
                    :route route :window-shift offset
                    :peaks (mix-peaks pcm (max 1 (ceiling (/ (length pcm) 2 96)))))))
    (ensure-directories-exist wave)
    (handler-case
        (progn (write-stereo-wave wave (mixer-rate mixer) pcm)
               (write-data manifest row))
      (error (condition) (when (probe-file wave) (delete-file wave)) (error condition)))
    (setf (mixer-takes mixer) (append (mixer-takes mixer) (list row)))
    row))

(defun take-input-worker (record rate from to &optional (device (take-input-device)))
  (handler-case
      (sb-alien:with-alien ((pcm sb-alien:system-area-pointer) (delay sb-alien:long))
        (stream-check (stream-open (sb-alien:addr pcm) device 1 1))
        (unwind-protect
             (let* ((block (make-array (* 2 +stream-block+) :element-type '(signed-byte 32)))
                    (output (make-array (* 2 (- to from)) :element-type '(signed-byte 32)))
                    (timeline nil)
                    (deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second)))
                    (done 0)
                    (play (capture-take-stream record)))
               (stream-check (stream-params pcm (stream-format "S32_LE") 3 2 rate 0 48000))
               (stream-check (take-start pcm))
               (sb-sys:with-pinned-objects (block)
                 (loop until (capture-take-stop record)
                       while (< done (- to from))
                       for n = (take-read pcm (sb-sys:vector-sap block) +stream-block+)
                       do (when (>= (get-internal-real-time) deadline)
                            (error "Capture timed out."))
                          (cond
                            ((or (= n -11) (zerop n)) (sleep .002))
                            ((minusp n) (stream-check n))
                            (t
                             (unless timeline
                               (setf timeline (- (mix-stream-cursor play) n
                                                 (if (zerop (stream-delay pcm (sb-alien:addr delay)))
                                                     (max 0 delay) 0)))
                               (when (> timeline from)
                                 (error "Capture opened after the punch start. Try again.")))
                             (loop for i below n
                                   for frame from timeline
                                   when (<= from frame (1- to))
                                     do (let* ((offset (* 2 (- frame from)))
                                               (sample (ash (aref block (* i 2)) -8)))
                                          (setf (aref output offset) sample
                                                (aref output (1+ offset)) sample)
                                          (incf done)))
                             (incf timeline n)))))
               (when (= done (- to from))
                 (setf (capture-take-result record) output)))
          (stream-close pcm)))
    (error (condition) (setf (capture-take-error record) (princ-to-string condition)))))

(defun take-cancel (mixer)
  (let ((record (mixer-recording mixer)))
    (when record
      (setf (capture-take-stop record) t)
      (when (capture-take-thread record) (sb-thread:join-thread (capture-take-thread record)))
      (setf (mixer-recording mixer) nil)
      (mixer-stop mixer))))

(defun take-tick (mixer)
  (let ((record (mixer-recording mixer)))
    (when record
      (cond ((not (sb-thread:thread-alive-p (capture-take-thread record)))
             (let ((result (capture-take-result record))
                   (reason (capture-take-error record)))
               (take-cancel mixer)
               (if result (persist-take mixer result (capture-take-route record) (capture-take-offset record))
                   (setf (mixer-error mixer) (or reason "Capture stopped without a complete take.")))))
            ((>= (get-internal-real-time) (capture-take-check record))
             (setf (capture-take-check record) (+ (get-internal-real-time)
                                                 (floor internal-time-units-per-second 4)))
             (when (or (not (sb-thread:thread-alive-p (mix-stream-thread (capture-take-stream record))))
                       (capture-take-error record))
               (take-cancel mixer)
               (setf (mixer-error mixer) "Playback or the wired headphones/microphone disconnected.")))))))

(defun take-range (mixer from to)
  (let* ((project (mixer-snapshot mixer))
         (first (beats-to-frame project (section-start project "B")))
         (last (beats-to-frame project (section-boundary project "B")))
         (rate (mixer-rate mixer)))
    (unless (and (<= first from) (<= (+ from (round rate 2)) to last)
                 (<= (- to from) (* 15 rate)))
      (error "Choose a punch of 0.5–15 seconds inside B."))
    (setf (mixer-punch-from mixer) from (mixer-punch-to mixer) to)))

(defun take-launch (mixer)
  (unless (and (mixer-takes-ready mixer) (take-input-device))
    (error "Set AMOEBA_CAPTURE_PCM before you start the session and confirm the route."))
  (unless (mixer-punch-from mixer) (error "Set the punch range first."))
  (when (mixer-dirty-p mixer) (error "Save or undo the active mix draft before recording."))
  (mixer-stop mixer)
  (let* ((from (mixer-punch-from mixer)) (to (mixer-punch-to mixer))
         (rate (mixer-rate mixer))
         (route (mixer-takes-ready mixer))
         (offset (capture-window-shift route rate))
         (record (make-capture-take :route route :offset offset)))
    (unless (>= from rate) (error "Leave at least one second of preroll."))
    (setf (mixer-recording mixer) record)
    (handler-case
        (progn
          (setf (mixer-cursor mixer) (- from rate))
          (mixer-start mixer)
          (let ((play (mixer-playback mixer)))
            (setf (capture-take-stream record) play
                  (capture-take-thread record)
                  (sb-thread:make-thread (lambda () (take-input-worker record rate (+ from offset) (+ to offset)))
                                         :name "AMOEBA punch capture"))))
      (error (condition) (take-cancel mixer) (error condition)))))

(defun take-slice (row from to)
  (unless (<= (getf row :from) from (1- to) (1- (getf row :to)))
    (error "Slice is outside the recorded take."))
  (let ((fade (min 192 (floor (- to from) 2))))
    (list :id (concatenate 'string "comp-" (score-nonce)) :kind :clip :part "Voice"
          :unit :frame :start from :duration (- to from) :asset (getf row :asset)
          :asset-offset (- from (getf row :from)) :fade-in fade :fade-out fade)))

(defun trim-old-voice (snapshot item from to)
  (let* ((start (item-frame snapshot item))
         (end (ecase (getf item :unit)
                (:frame (+ start (getf item :duration)))
                (:beat (beats-to-frame snapshot (+ (getf item :start) (getf item :duration)))))))
    (if (or (<= end from) (>= start to)) (list item)
        (let ((head (when (< start from) (copy-list item)))
              (tail (when (> end to) (copy-list item))))
          (when head
            (setf (getf head :unit) :frame (getf head :start) start
                  (getf head :duration) (- from start)))
          (when tail
            (setf (getf tail :id) (concatenate 'string "trim-" (score-nonce))
                  (getf tail :unit) :frame (getf tail :start) to (getf tail :duration) (- end to)
                  (getf tail :asset-offset) (+ (- to start) (or (getf item :asset-offset) 0))))
          (append (when head (list head)) (when tail (list tail)))))))

(defun take-preview (mixer specs type)
  (when (and (mixer-dirty-p mixer) (not (mixer-take-preview mixer)))
    (error "Save or undo other mix edits before comping."))
  (unless (<= 1 (length specs) 8) (error "Choose up to eight slices."))
  (let* ((base (or (mixer-take-base mixer) (mixer-items mixer)))
         (snapshot (mixer-snapshot mixer))
         (from (or (mixer-punch-from mixer) (error "Set a punch range first.")))
         (to (mixer-punch-to mixer))
         (clips (loop with prior = from for (id start end) in (sort specs #'< :key #'second)
                      collect (progn
                                (unless (<= prior start (1- end) (1- to))
                                  (error "Slices overlap or are outside the punch."))
                                (setf prior end)
                                (take-slice (or (find id (mixer-takes mixer) :key #'take-key :test #'equal)
                                                (error "Take not found.")) start end))))
         (new (append
               (loop for item in base
                     append (if (and (equal "Voice" (getf item :part)) (eq :clip (getf item :kind)))
                                (trim-old-voice snapshot item from to) (list item)))
               clips))
         (old (mixer-items mixer)))
    (when (eq type :comp)
      (let ((cursor from))
        (dolist (clip clips)
          (unless (= (getf clip :start) cursor) (error "The comp must cover the punch without gaps."))
          (incf cursor (getf clip :duration)))
        (unless (= cursor to) (error "The comp must cover the punch without gaps."))))
    (setf (mixer-items mixer) new)
    (handler-case (mixer-refresh-b mixer)
      (error (condition) (setf (mixer-items mixer) old) (error condition)))
    (setf (mixer-take-base mixer) base (mixer-take-preview mixer) type (mixer-mode mixer) "b")
    (mixer-publish mixer)))

(defun take-discard-preview (mixer)
  (when (mixer-take-preview mixer)
    (setf (mixer-items mixer) (mixer-take-base mixer)
          (mixer-take-preview mixer) nil (mixer-take-base mixer) nil)
    (mixer-refresh-b mixer)
    (mixer-publish mixer)))

(defun take-status-json (mixer)
  (let* ((snapshot (mixer-snapshot mixer))
         (rate (mixer-rate mixer))
         (has-b (assoc "B" (getf snapshot :sections) :test #'equal))
         (supported (and has-b (member "Voice" (getf snapshot :parts) :test #'equal))))
    (unless supported (return-from take-status-json "{\"supported\":false}"))
    (unless (mixer-punch-from mixer)
      (let* ((first (beats-to-frame snapshot (section-start snapshot "B")))
             (last (beats-to-frame snapshot (section-boundary snapshot "B"))))
        (setf (mixer-punch-from mixer) first (mixer-punch-to mixer) (min last (+ first (* 4 rate))))
        (load-takes mixer)))
    (with-output-to-string (out)
      (format out "{\"supported\":true,\"from\":~D,\"to\":~D,\"ready\":~A,\"recording\":~A,\"preview\":~A,\"comp\":~A,\"route\":\"~(~A~)\",\"calibrated\":~A,\"takes\":["
              (mixer-punch-from mixer) (mixer-punch-to mixer)
              (if (mixer-takes-ready mixer) "true" "false")
              (if (mixer-recording mixer) "true" "false")
              (if (mixer-take-preview mixer) "true" "false")
              (if (eq :comp (mixer-take-preview mixer)) "true" "false")
              (or (mixer-takes-ready mixer) :none)
              (if (capture-profile (mixer-takes-ready mixer) rate) "true" "false"))
      (loop for row in (mixer-takes mixer) for n from 0 do
        (unless (zerop n) (write-char #\, out))
        (write-string "{\"id\":" out) (mixer-json-text out (getf row :id))
        (format out ",\"from\":~D,\"to\":~D,\"peaks\":[~{~{[~D,~D]~}~^,~}]}"
                (getf row :from) (getf row :to) (getf row :peaks)))
      (write-string "]}" out))))

(defun parse-take-slice (value)
  (let* ((first (position #\, value)) (last (position #\, value :from-end t)))
    (unless (and first last (< first last)) (error "Invalid comp slice."))
    (list (subseq value 0 first) (parse-integer value :start (1+ first) :end last)
          (parse-integer value :start (1+ last)))))

(defun take-action (mixer path)
  (let ((action (first path)) (args (rest path)))
    (when (and (mixer-recording mixer) (not (equal action "take-cancel")))
      (error "Finish or cancel the active take first."))
    (cond
      ((and (equal action "take-confirm") (null args))
       (unless (take-input-device) (error "Start the session with AMOEBA_CAPTURE_PCM set."))
       (setf (mixer-takes-ready mixer) :configured))
      ((and (equal action "take-range") (= (length args) 2))
       (take-discard-preview mixer)
       (apply #'take-range mixer (mapcar #'parse-integer args)))
      ((and (equal action "take-record") (null args))
       (take-launch mixer))
      ((and (equal action "take-cancel") (null args))
       (take-cancel mixer))
      ((and (equal action "take-listen") (= (length args) 1))
       (let ((row (or (find (first args) (mixer-takes mixer) :key #'take-key :test #'equal)
                      (error "Take not found."))))
         (take-preview mixer (list (list (first args) (max (mixer-punch-from mixer) (getf row :from))
                                         (min (mixer-punch-to mixer) (getf row :to)))) :audition)
         (mixer-stop mixer)
         (setf (mixer-cursor mixer) (mixer-punch-from mixer))
         (mixer-start mixer)))
      ((and (equal action "take-comp") (<= 1 (length args) 8))
       (take-preview mixer (mapcar #'parse-take-slice args) :comp)
       (if (mixer-playback mixer)
           (setf (mix-stream-seek (mixer-playback mixer)) (mixer-punch-from mixer))
           (progn (setf (mixer-cursor mixer) (mixer-punch-from mixer))
                  (mixer-start mixer))))
      ((and (equal action "take-apply") (null args))
       (unless (and (eq :comp (mixer-take-preview mixer)) (equal "b" (mixer-mode mixer)))
         (error "Preview the comp in B before applying."))
       (mixer-save mixer)
       (setf (mixer-take-base mixer) nil (mixer-take-preview mixer) nil))
      ((and (equal action "take-discard") (null args))
       (take-discard-preview mixer))
      (t (error "Invalid take action."))))
  nil)
