(in-package #:score-prototype)

(defun audition-data (root)
  (let ((path (project-file root "audition.sexp")))
    (when (probe-file path) (read-data path))))

(defun section-start (project id)
  (- (section-boundary project id)
     (* (getf project :beats-per-bar)
        (second (assoc id (getf project :sections) :test #'equal)))))

(defun audition-window (project id comparison)
  (let* ((bar (getf project :beats-per-bar))
         (end (section-boundary project id))
         (start (section-start project id)))
    (if comparison
        (values (max start (- end (* 2 bar))) (+ end (* 5 bar)))
        (values start (+ end (* 2 bar))))))

(defun item-frame (project item)
  (let ((start (getf item :start)))
    (ecase (getf item :unit) (:beat (beats-to-frame project start)) (:frame start))))

(defun part-gain (project data part frame)
  (loop with rate = (getf project :sample-rate)
        for item in (getf project :items)
        for value = (cdr (assoc (getf item :id) (getf data :automation) :test #'equal))
        when (and value (equal part (getf item :part))
                  (<= (item-frame project item) frame))
          return (+ 1d0 (* (- value 1d0)
                           (min 1d0 (/ (- frame (item-frame project item)) (* .015d0 rate)))))
        finally (return 1d0)))

(defun write-le (stream value bytes)
  (dotimes (index bytes) (write-byte (ldb (byte 8 (* 8 index)) value) stream)))

(defun read-le (stream bytes)
  (loop for index below bytes sum (ash (read-byte stream) (* 8 index))))

(defun wav-tag (stream)
  (coerce (loop repeat 4 collect (code-char (read-byte stream))) 'string))

(deftype sample-vector () '(simple-array (signed-byte 32) (*)))
(deftype octet-vector () '(simple-array (unsigned-byte 8) (*)))
(defconstant +pcm-block-samples+ 16384)

(defun decode-pcm (stream samples bytes)
  (declare (type sample-vector samples)
           (type (integer 2 4) bytes)
           (optimize (speed 3) (safety 1)))
  (let ((buffer (make-array (* +pcm-block-samples+ bytes) :element-type '(unsigned-byte 8)))
        (modulus (ash 1 (* bytes 8)))
        (sign (ash 1 (1- (* bytes 8)))))
    (declare (type octet-vector buffer) (type (unsigned-byte 33) modulus sign))
    (loop for start of-type fixnum from 0 below (length samples) by +pcm-block-samples+
          for count of-type fixnum = (min +pcm-block-samples+ (- (length samples) start))
          for size of-type fixnum = (* count bytes)
          do (unless (= size (read-sequence buffer stream :end size))
               (error "Truncated PCM data."))
             (loop for i of-type fixnum below count
                   for j of-type fixnum from 0 by bytes
                   for lower of-type (unsigned-byte 16) =
                     (logior (aref buffer j) (ash (aref buffer (+ j 1)) 8))
                   for word of-type (unsigned-byte 32) =
                     (case bytes
                       (2 lower)
                       (3 (logior lower (ash (aref buffer (+ j 2)) 16)))
                       (4 (logior lower (ash (aref buffer (+ j 2)) 16)
                                        (ash (aref buffer (+ j 3)) 24))))
                   do (setf (aref samples (+ start i))
                            (if (< word sign) word (- word modulus))))))
  samples)

(defun read-pcm-wave (path rate)
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (unless (equal (wav-tag in) "RIFF") (error "Expected RIFF WAV: ~A" path))
    (read-le in 4)
    (unless (equal (wav-tag in) "WAVE") (error "Expected WAVE: ~A" path))
    (loop with channels and bits
          while (<= (+ (file-position in) 8) (file-length in))
          for tag = (wav-tag in) for size = (read-le in 4)
          for end = (+ (file-position in) size (mod size 2))
          do (unless (<= end (file-length in)) (error "Truncated WAV chunk: ~A" path))
             (cond ((equal tag "fmt ")
                    (unless (>= size 16) (error "Invalid WAV format chunk."))
                    (let ((codec (read-le in 2)))
                      (setf channels (read-le in 2))
                      (let ((sample-rate (read-le in 4)))
                        (read-le in 4)
                        (let ((alignment (read-le in 2)))
                          (setf bits (read-le in 2))
                          (let ((pcm (or (= codec 1)
                                         (and (= codec 65534) (>= size 40)
                                              (progn (read-le in 2) (read-le in 2) (read-le in 4)
                                                     (= (read-le in 16) #x719b3800aa0000800010000000000001))))))
                            (unless (and pcm (member channels '(1 2)) (member bits '(16 24 32))
                                         (= sample-rate rate) (= alignment (* channels (/ bits 8))))
                              (error "Expected mono or stereo PCM WAV at ~D Hz: ~A" rate path)))))))
                   ((equal tag "data")
                    (let ((bytes (and bits (/ bits 8))))
                      (unless (and bytes (zerop (mod size (* bytes channels))))
                        (error "Invalid PCM data alignment: ~A" path))
                      (let ((pcm (make-array (/ size bytes) :element-type '(signed-byte 32)))
                            (sign (ash 1 (1- bits))))
                        (decode-pcm in pcm bytes)
                        (return-from read-pcm-wave (values pcm channels sign))))))
             (file-position in end)))
  (error "Missing WAV data: ~A" path))

(defun write-pcm24 (stream pcm)
  (declare (type sample-vector pcm)
           (optimize (speed 3) (safety 1)))
  (let ((buffer (make-array (* 3 +pcm-block-samples+) :element-type '(unsigned-byte 8)))
        (peak 0))
    (declare (type octet-vector buffer) (type fixnum peak))
    (loop for start of-type fixnum from 0 below (length pcm) by +pcm-block-samples+
          for count of-type fixnum = (min +pcm-block-samples+ (- (length pcm) start))
          do (loop for i of-type fixnum below count
                   for j of-type fixnum from 0 by 3
                   for sample of-type (signed-byte 32) = (aref pcm (+ start i))
                   do (unless (<= -8388608 sample 8388607)
                        (error "Mix would clip. Lower the project gain and render again."))
                      (setf peak (max peak (abs sample))
                            (aref buffer j) (ldb (byte 8 0) sample)
                            (aref buffer (+ j 1)) (ldb (byte 8 8) sample)
                            (aref buffer (+ j 2)) (ldb (byte 8 16) sample)))
             (write-sequence buffer stream :end (* count 3)))
    peak))

(defun write-stereo-wave (path rate pcm)
  (with-open-file (out path :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
    (flet ((tag (text) (map nil (lambda (char) (write-byte (char-code char) out)) text)))
      (tag "RIFF") (write-le out (+ 36 (* 3 (length pcm))) 4) (tag "WAVE")
      (tag "fmt ") (write-le out 16 4) (write-le out 1 2) (write-le out 2 2)
      (write-le out rate 4) (write-le out (* rate 6) 4) (write-le out 6 2) (write-le out 24 2)
      (tag "data") (write-le out (* 3 (length pcm)) 4)
      (write-pcm24 out pcm))))

(defun automation-gain (item data)
  (let ((db (getf item :gain-db)))
    (if db (expt 10d0 (/ db 200d0))
        (cdr (assoc (getf item :id) (getf data :automation) :test #'equal)))))

(defun mix-envelope (project data part)
  (let ((points (loop for item in (getf project :items)
                      for value = (automation-gain item data)
                      when (and value (equal part (getf item :part)))
                        collect (cons (item-frame project item) value))))
    (loop with previous = 1d0
          for (frame . gain) in (sort points #'< :key #'car)
          collect (list frame previous (- gain previous)) into rising
          do (setf previous gain)
          finally (return (nreverse rising)))))

(declaim (inline mix-gain))
(defun mix-gain (points frame ramp)
  (declare (type fixnum frame) (type double-float ramp)
           (optimize (speed 3) (safety 1)))
  (loop for (start previous change) in points
        when (<= (the fixnum start) frame)
          return (+ (the double-float previous)
                    (* (the double-float change)
                       (min 1d0 (/ (- frame (the fixnum start)) ramp))))
        finally (return 1d0)))

(defun trim-factor (project part)
  (let ((db (cdr (assoc part (getf project :mix-trim) :test #'equal))))
    (if db (expt 10d0 (/ db 200d0)) 1d0)))

(defun scale-stem (pcm gain)
  (declare (type sample-vector pcm) (type double-float gain) (optimize (speed 3)))
  (unless (= gain 1d0)
    (dotimes (i (length pcm)) (setf (aref pcm i) (round (* gain (aref pcm i))))))
  pcm)

(defun mix-asset (pcm audio channels first-frame start end divisor l-factor r-factor points ramp base-gain &optional (source-offset 0) (fade-in 0) (fade-out 0))
  (declare (type sample-vector pcm audio)
           (type fixnum first-frame start end divisor source-offset fade-in fade-out)
           (type (integer 1 2) channels)
           (type double-float l-factor r-factor ramp base-gain)
           (optimize (speed 3) (safety 1)))
  (let* ((from (max start first-frame))
         (until (min end (+ first-frame (ash (length pcm) -1))))
         (inverse (/ 1d0 divisor)))
    (loop for frame of-type fixnum from from below until
          for i of-type fixnum from (* (+ source-offset (- from start)) channels) by channels
          for o of-type fixnum from (* (- from first-frame) 2) by 2
          for gain of-type double-float =
            (* base-gain (the double-float (mix-gain points frame ramp))
               (if (and (> fade-in 0) (< (- frame start) fade-in)) (/ (float (- frame start) 1d0) fade-in) 1d0)
               (if (and (> fade-out 0) (< (- end frame 1) fade-out)) (/ (float (- end frame 1) 1d0) fade-out) 1d0))
          do (incf (aref pcm o)
                   (round (* gain (* l-factor (* (float (aref audio i) 1d0) inverse)))))
             (incf (aref pcm (1+ o))
                   (round (* gain (* r-factor (* (float (aref audio (+ i (1- channels))) 1d0) inverse))))))))

(defun sum-stem (stem master part)
  (declare (type sample-vector stem master) (optimize (speed 3) (safety 1)))
  (loop for i of-type fixnum below (length stem)
        for sample of-type (signed-byte 32) = (aref stem i)
        do (unless (<= -8388608 sample 8388607)
             (error "Stem ~A would clip. Lower its gain." part))
           (incf (aref master i) sample)))

(defun render-part (root project data part first-frame frames)
  (let* ((mix (cdr (assoc part (getf data :mix) :test #'equal)))
         (pan (or (getf mix :pan) 0d0))
         (trim (or (getf mix :gain) 1d0))
         (angle (* (+ pan 1) (/ pi 4)))
         (left (cos angle)) (right (sin angle))
         (pcm (make-array (* frames 2) :element-type '(signed-byte 32) :initial-element 0))
         (last-frame (+ first-frame frames))
         (points (mix-envelope project data part))
         (ramp (* .015d0 (getf project :sample-rate)))
         (base-gain (* trim 8388607d0)))
    (unless (and (<= -1 pan 1) (<= 0 trim 4)) (error "Invalid gain or pan for ~A." part))
    (labels ((mix-sample (frame l r)
               (let ((offset (* 2 (- frame first-frame)))
                     (gain (* base-gain (mix-gain points frame ramp))))
                 (incf (aref pcm offset) (round (* gain l)))
                 (incf (aref pcm (1+ offset)) (round (* gain r)))))
             (tone (pitch start end)
               (let* ((rate (getf project :sample-rate))
                      (omega (/ (* 2 pi 440d0 (expt 2d0 (/ (- pitch 69) 12d0))) rate))
                      (ramp (* .008d0 rate)))
                 (loop for frame from (max start first-frame) below (min end last-frame)
                       for elapsed = (- frame start)
                       for envelope = (min 1d0 (/ elapsed ramp) (/ (- end frame) ramp))
                       for value = (* .055d0 envelope
                                      (+ (sin (* elapsed omega)) (* .20d0 (sin (* 2 elapsed omega)))))
                       do (mix-sample frame (* value left) (* value right))))))
      (dolist (item (getf project :items))
        (when (equal (getf item :part) part)
          (let ((asset (getf item :asset)) (id (getf item :id)))
            (cond (asset
                   (let* ((start (item-frame project item))
                          (duration (ecase (getf item :unit)
                                      (:frame (getf item :duration))
                                      (:beat (- (beats-to-frame project (+ (getf item :start) (getf item :duration))) start))))
                          (end (+ start duration)) (source-offset (or (getf item :asset-offset) 0)))
                     (when (and (< start last-frame) (> end first-frame))
                       (multiple-value-bind (audio channels divisor)
                           (read-pcm-wave (project-file root asset) (getf project :sample-rate))
                         (unless (<= 0 source-offset (+ source-offset duration) (/ (length audio) channels))
                           (error "Clip ~A exceeds its source WAV." id))
                         (let ((l-factor (if (= channels 1) left (min 1d0 (* (sqrt 2d0) left))))
                               (r-factor (if (= channels 1) right (min 1d0 (* (sqrt 2d0) right))))
                               (asset-gain (or (getf mix :asset-gain) .35d0)))
                           (mix-asset pcm audio channels first-frame start end divisor
                                      (* asset-gain l-factor) (* asset-gain r-factor)
                                      points ramp base-gain source-offset
                                      (or (getf item :fade-in) 0) (or (getf item :fade-out) 0)))))))
                  ((member id (getf data :instruments) :test #'equal)
                   (dolist (note (cdr (assoc id (getf data :notes) :test #'equal)))
                     (destructuring-bind (offset duration pitch) note
                       (let ((beat (+ offset (getf item :start))))
                         (tone pitch (beats-to-frame project beat)
                               (beats-to-frame project (+ beat duration))))))))))))
    (scale-stem pcm (trim-factor project part))))

(defun render-mix (root project from to &key part-sink)
  (let* ((data (audition-data root))
         (rate (getf project :sample-rate))
         (first (beats-to-frame project from))
         (frames (- (beats-to-frame project to) first))
         (parts (getf project :parts)))
    (unless (<= 1 frames (* 600 rate)) (error "Render ranges must be between one frame and ten minutes."))
    (unless (and parts (<= (length parts) 32)) (error "This renderer supports 1–32 parts."))
    (let ((master (make-array (* 2 frames) :element-type '(signed-byte 32) :initial-element 0)))
      (dolist (part parts)
        (let ((stem (render-part root project data part first frames)))
          (when part-sink (funcall part-sink part stem))
          (sum-stem stem master part)))
      master)))

(defun write-audition (root project from to path)
  (unless (<= 1 (- (beats-to-frame project to) (beats-to-frame project from))
              (* 90 (getf project :sample-rate)))
    (error "Choose a playback range up to 90 seconds."))
  (write-stereo-wave path (getf project :sample-rate) (render-mix root project from to))
  path)

(defun project-render-end (project)
  (let ((rate (getf project :sample-rate)))
    (max (section-boundary project (first (car (last (getf project :sections)))))
         (loop for item in (getf project :items)
               for end = (+ (getf item :start) (getf item :duration))
               maximize (ecase (getf item :unit) (:beat end)
                               (:frame (/ (* end (getf project :bpm)) (* 60 rate))))))))

(sb-alien:define-alien-routine ("renameat2" rename-with-flags) sb-alien:int
  (old-dir sb-alien:int) (old sb-alien:c-string) (new-dir sb-alien:int)
  (new sb-alien:c-string) (flags sb-alien:unsigned-int))

(defun export-stems (root project target)
  (let* ((name (string-right-trim "/" (namestring target)))
         (stage (dirpath (sb-posix:mkdtemp (concatenate 'string name ".XXXXXX"))))
         (rate (getf project :sample-rate))
         (to (project-render-end project))
         (files nil))
    (unwind-protect
         (let* ((parts nil)
                (master (render-mix root project 0 to
                                    :part-sink (lambda (part pcm)
                                                 (let ((file (format nil "stem-~2,'0D.wav" (1+ (length parts)))))
                                                   (push (merge-pathnames file stage) files)
                                                   (push (list :part part :file file
                                                               :peak (write-stereo-wave (first files) rate pcm))
                                                         parts)))))
                (mix (merge-pathnames "mix.wav" stage))
                (manifest (merge-pathnames "manifest.sexp" stage)))
           (push mix files)
           (let ((peak (write-stereo-wave mix rate master)))
             (push manifest files)
             (write-data manifest (list :revision (getf project :revision) :title (getf project :title)
                                        :sample-rate rate :bits 24 :channels 2 :start-frame 0
                                        :frames (/ (length master) 2) :master "mix.wav"
                                        :peak peak :stems (nreverse parts))))
           (unless (zerop (rename-with-flags -100 (string-right-trim "/" (namestring stage))
                                            -100 name 1))
             (error "Could not publish stems at ~A; destination may already exist." name))
           name)
      (when (probe-file stage)
        (dolist (file files) (when (probe-file file) (delete-file file)))
        (sb-posix:rmdir (namestring stage))))))

(defun audio-device (root)
  (or (sb-ext:posix-getenv "AMOEBA_PCM") (getf (audition-data root) :pcm) "default"))

(defun start-audition (root project from to)
  (let ((program "aplay") (pcm (audio-device root)))
    (multiple-value-bind (fd file) (sb-posix:mkstemp "/tmp/three-rooms.XXXXXX")
      (sb-posix:close fd)
      (handler-case
          (progn
            (write-audition root project from to file)
            (let ((process (sb-ext:run-program program (list "-q" "-D" pcm file)
                                               :search t :input nil :output t :error t :wait nil)))
              (sleep .08)
              (when (and (not (sb-ext:process-alive-p process))
                         (not (eql (sb-ext:process-exit-code process) 0)))
                (error "Could not open ALSA output ~A. Check device and active audio routes." pcm))
              (cons process file)))
        (error (condition) (delete-file file) (error condition))))))

(defun finish-audition (playback &optional stop)
  (when playback
    (unwind-protect
         (progn
           (when (and stop (sb-ext:process-alive-p (car playback)))
             (sb-ext:process-kill (car playback) 15))
           (sb-ext:process-wait (car playback))
           (sb-ext:process-exit-code (car playback)))
      (when (probe-file (cdr playback)) (delete-file (cdr playback))))))
